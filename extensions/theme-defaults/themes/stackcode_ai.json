	"tokenColors": [
		{
			"name": "Default text",
			"scope": [
				"source",
				"text"
			],
			"settings": {
				"foreground": "#FFFFFF"
			}
		},
		{
			"name": "Markdown - All text white",
			"scope": [
				"text.html.markdown",
				"meta.paragraph.markdown",
				"string.other.link.title.markdown",
				"string.other.link.description.markdown"
			],
			"settings": {
				"foreground": "#FFFFFF"
			}
		},
		{
			"name": "Markdown - Headings orange (highest priority)",
			"scope": [
				"heading.1.markdown entity.name.section.markdown",
				"heading.2.markdown entity.name.section.markdown",
				"heading.3.markdown entity.name.section.markdown",
				"heading.4.markdown entity.name.section.markdown",
				"heading.5.markdown entity.name.section.markdown",
				"heading.6.markdown entity.name.section.markdown",
				"markup.heading.markdown",
				"markup.heading",
				"entity.name.section.markdown",
				"punctuation.definition.heading.markdown"
			],
			"settings": {
				"foreground": "#F26D21",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown - Bold orange",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#F26D21",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown - Italic orange",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#F26D21",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown - Links orange",
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#F26D21"
			}
		},
		{
			"name": "Markdown - List markers orange",
			"scope": [
				"punctuation.definition.list",
				"markup.list"
			],
			"settings": {
				"foreground": "#F26D21"
			}
		},
		{
			"name": "Markdown - Code blocks white",
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code",
				"markup.raw",
				"meta.embedded.block"
			],
			"settings": {
				"foreground": "#FFFFFF"
			}
		},
		{
			"name": "Markdown - Code fence markers orange",
			"scope": [
				"punctuation.definition.raw",
				"punctuation.definition.markdown",
				"fenced_code.block.language"
			],
			"settings": {
				"foreground": "#F26D21"
			}
		},
		{
			"name": "Markdown - Blockquote orange",
			"scope": [
				"markup.quote",
				"punctuation.definition.quote"
			],
			"settings": {
				"foreground": "#F26D21"
			}
		},
		{
			"name": "Markdown - Horizontal rule orange",
			"scope": [
				"meta.separator.markdown"
			],
			"settings": {
				"foreground": "#F26D21"
			}
		},
		{
			"name": "Markdown - Table content white",
			"scope": [
				"markup.table"
			],
			"settings": {
				"foreground": "#FFFFFF"
			}
		},
		{
			"name": "Markdown - Table separator orange",
			"scope": [
				"punctuation.separator.table-cell.markdown",
				"punctuation.definition.table.markdown"
			],
			"settings": {
				"foreground": "#F26D21"
			}
		},
		{
			"name": "Markdown - Strikethrough",
			"scope": [
				"markup.strikethrough"
			],
			"settings": {
				"foreground": "#888888",
				"fontStyle": "strikethrough"
			}
		},
		{
			"name": "Markdown - Changed/Inserted/Deleted",
			"scope": [
				"markup.changed",
				"markup.inserted",
				"markup.deleted"
			],
			"settings": {
				"foreground": "#F26D21"
			}
		},
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#888888"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#CE9178"
			}
		},
		{
			"name": "Numbers",
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#B5CEA8"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage.type"
			],
			"settings": {
				"foreground": "#C586C0"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": {
				"foreground": "#DCDCAA"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"support.type"
			],
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "Constants",
			"scope": "constant",
			"settings": {
				"foreground": "#4FC1FF"
			}
		},
		{
			"name": "Classes",
			"scope": [
				"entity.name.class",
				"entity.name.namespace"
			],
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "Interfaces",
			"scope": "entity.name.interface",
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "Enums",
			"scope": "entity.name.enum",
			"settings": {
				"foreground": "#B8D7A3"
			}
		},
		{
			"name": "Enum members",
			"scope": "variable.other.enummember",
			"settings": {
				"foreground": "#4FC1FF"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"meta.brace"
			],
			"settings": {
				"foreground": "#CCCCCC"
			}
		},
		{
			"name": "Operators",
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#D4D4D4"
			}
		}
	]
}
